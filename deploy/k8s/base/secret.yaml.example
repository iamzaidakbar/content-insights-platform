# Copy to secret.yaml and fill values. Never commit secret.yaml.
#   cp secret.yaml.example secret.yaml
#   kubectl apply -f secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: cip-api-secrets
  namespace: cip
  labels:
    app.kubernetes.io/name: cip-api
    app.kubernetes.io/part-of: content-insights-platform
type: Opaque
stringData:
  MONGODB_URI: "mongodb+srv://USER:PASSWORD@CLUSTER/content-insights"
  JWT_ACCESS_SECRET: "replace-with-long-random-string"
  JWT_REFRESH_SECRET: "replace-with-different-long-random-string"
  ELASTICSEARCH_URL: "https://YOUR_DEPLOYMENT.es.io:443"
  ELASTICSEARCH_API_KEY: "replace-with-elastic-api-key"
  REDIS_URL: "rediss://default:PASSWORD@HOST:6379"
