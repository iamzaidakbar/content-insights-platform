# ------------------------------------------------------------------------------
# Content Insights Platform — environment configuration
# Copy to `.env` at the repo root. Consumed by docker-compose.yml (service env
# vars) and, for apps/api, also loaded directly via dotenv when run outside Docker.
# ------------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# --- Service ports (host-side; also read inside the containers) --------------
API_PORT=4000
WEB_PORT=5173

# --- CORS ----------------------------------------------------------------
# Origin the API accepts requests from (the web app's dev server).
CORS_ORIGIN=http://localhost:5173

# --- Auth (JWT) ------------------------------------------------------------
# Secrets used to sign/verify JWTs. Use long, random, unique values and
# rotate/replace them for real environments — never reuse these dev
# placeholders or commit real secrets to source control.
# Access tokens are short-lived (15m) and returned in the JSON response body
# only; refresh tokens are longer-lived (7d) and set as an httpOnly cookie.
# Two distinct secrets mean a leaked access-token secret alone can't be used
# to mint forged refresh tokens (and vice versa).
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production

# --- Web app (Vite) ----------------------------------------------------------
# Base URL the BROWSER uses to reach the API — not the Docker compose service
# name (`api:4000`). It's the browser making these requests, not the web
# container, so this must always be host-reachable, identical whether running
# natively or via docker-compose.
VITE_API_URL=http://localhost:4000/api

# --- MongoDB -------------------------------------------------------------
# In-container form (used by docker-compose; `mongodb` is the compose
# service name/hostname on the shared network, rs0 is the single-node
# replica set the mongodb service self-initiates via its healthcheck).
MONGODB_URI=mongodb://mongodb:27017/content-insights?replicaSet=rs0

# Host-machine form — use when running apps/api directly on the host against
# the dockerized mongodb container's published port. directConnection=true is
# required because the replica-set hostname `mongodb` only resolves inside
# the compose network.
# MONGODB_URI=mongodb://localhost:27017/content-insights?directConnection=true

# --- Elasticsearch ---------------------------------------------------------
ELASTICSEARCH_URL=http://elasticsearch:9200
# Host-machine form:
# ELASTICSEARCH_URL=http://localhost:9200

# JVM heap size for the single-node elasticsearch container (dev sizing).
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379
# Host-machine form:
# REDIS_URL=redis://localhost:6379
