# ==============================================================================
# Production env template (safe to commit). Copy values into `.env.prod` (gitignored).
# Vercel only needs the VITE_* vars. The API host needs the rest.
# ==============================================================================

NODE_ENV=production

# --- Vercel (Project → Settings → Environment Variables) ---------------------
VITE_API_URL=https://YOUR_API_HOST/api
VITE_APP_ENV=production

# --- API host ----------------------------------------------------------------
API_PORT=4000
CORS_ORIGIN=https://YOUR_VERCEL_APP.vercel.app
COOKIE_SAMESITE=none

JWT_ACCESS_SECRET=generate-a-long-random-string
JWT_REFRESH_SECRET=generate-a-different-long-random-string

# MongoDB Atlas → Connect → Drivers (include /content-insights before ?)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/content-insights?appName=CI

# Elastic Cloud Hosted → deployment → Elasticsearch endpoint
ELASTICSEARCH_URL=https://YOUR_DEPLOYMENT.es.REGION.gcp.cloud.es.io:443
# Elastic Cloud → Deployment → API keys → Create (required for cloud; leave empty for local Docker ES)
ELASTICSEARCH_API_KEY=

# Upstash → Redis → Connect → Node.js (ioredis). Use rediss:// (TLS), NOT the REST URL/token.
# This app does not use UPSTASH_REDIS_REST_* — only REDIS_URL.
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

UPLOAD_DIR=./uploads
